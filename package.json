{
  "name": "three-server-encrypted-transfer",
  "version": "1.0.0",
  "private": true,
  "description": "Resilient three-node encrypted file transfer with envelope encryption, chunk verification, and mutual TLS.",
  "keywords": [
    "encryption",
    "file-transfer",
    "mutual-tls",
    "mtls",
    "envelope-encryption",
    "aes-gcm",
    "vault",
    "secure-storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesam92991/three-server-encrypted-transfer.git"
  },
  "bugs": {
    "url": "https://github.com/wesam92991/three-server-encrypted-transfer/issues"
  },
  "homepage": "https://github.com/wesam92991/three-server-encrypted-transfer#readme",
  "main": "server1-upload/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test:security": "node --test tests/security/**/*.test.js",
    "lint": "find shared server1-upload server2-relay server3-storage connector -maxdepth 1 -type f -name '*.js' -print0 | xargs -0 -r -n1 node --check",
    "start:server1": "node server1-upload/index.js",
    "start:server2": "node server2-relay/index.js",
    "start:server3": "node server3-storage/index.js",
    "connector": "node connector/index.js",
    "certs:dev": "node config/generate-dev-certs.js",
    "build:connector": "node scripts/build-connector.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@yao-pkg/pkg": "^5.16.1",
    "better-sqlite3": "^11.8.1",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {},
  "pkg": {
    "assets": [
      "config/templates/**",
      "docs/**",
      "migrations/**",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  }
}
